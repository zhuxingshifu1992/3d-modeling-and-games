config_version=5

[application]
config/name="公路滑板 · 逐风 Downhill Flow"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="DownhillFlow"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.2,0.55,0.8,1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
